generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

enum JobStatus {
  ESTIMATED // 견적만 받은 상태. 사용자가 승인하기 전에는 Higgsfield에 제출하지 않는다.
  QUEUED
  IN_PROGRESS
  COMPLETED
  FAILED
  NSFW
  CANCELED
}

enum AssetKind {
  IMAGE
  VIDEO
}

enum Approval {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  name         String
  passwordHash String
  createdAt    DateTime        @default(now())
  sessions     Session[]
  memberships  Membership[]
  jobs         GenerationJob[]
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Workspace {
  missions    Mission[]
  paper       PaperAccount?
  paperTrades PaperTrade[]
  id          String          @id @default(cuid())
  name        String
  createdAt   DateTime        @default(now())
  memberships Membership[]
  brand       BrandMemory?
  jobs        GenerationJob[]
  assets      Asset[]
  briefs      Brief[]
  brandAssets BrandAsset[]
}

model Membership {
  userId      String
  workspaceId String
  role        Role
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

model BrandMemory {
  workspaceId  String    @id
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  businessName String
  industry     String
  websiteUrl   String?
  speechLevel  String // "존댓말" | "반말"
  voice        String // 말투와 분위기
  audience     String
  offers       String
  doSay        String
  dontSay      String
  channels     String[]
  palette      String[] // hex 색상
  updatedAt    DateTime  @updatedAt
}

model GenerationJob {
  id            String    @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById   String
  createdBy     User      @relation(fields: [createdById], references: [id])
  modelKey      String
  input         Json
  status        JobStatus @default(ESTIMATED)
  estimateUsd   Decimal?  @db.Decimal(12, 6)
  estimateKrw   Int?
  estimateNote  String?
  hfRequestId   String?   @unique
  statusUrl     String?
  cancelUrl     String?
  error         String?
  hfExpiresAt   DateTime? // Higgsfield가 원본 파일을 지우는 시각
  lastCheckedAt DateTime?
  submittedAt   DateTime?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  assets        Asset[]
  briefId       String?
  brief         Brief?    @relation(fields: [briefId], references: [id], onDelete: SetNull)
  outputCount   Int? // 완료 때 Higgsfield가 돌려준 결과 파일 수. 복사가 끝났는지 판단하는 기준
  sourceAssetId String? // 이 자산을 시작 이미지로 만든 영상 작업일 때

  @@index([workspaceId, createdAt])
}

// 브리프: "무엇을, 어느 채널에, 몇 개" 한 번의 요청. 시안 작업 여러 개를 묶는다.
model Brief {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById  String
  what         String
  channel      String
  ratio        String
  ratioNote    String? // 원하는 화면비를 모델이 지원하지 않아 바꾼 경우의 설명
  modelKey     String
  modelReason  String
  variants     Int
  copyDraft    Json? // 글샘이 쓴 문구 초안 (LLM 출력)
  copyWarnings String[] // 코드 규칙 검사에서 나온 확인 사항
  copyModel    String?
  missionId    String?
  createdAt    DateTime        @default(now())
  jobs         GenerationJob[]

  @@index([workspaceId, createdAt])
}

// 사장님이 올린 제품 사진과 로고 (브랜드 키트)
model BrandAsset {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  kind        String // "PRODUCT" | "LOGO"
  name        String
  storageKey  String
  contentType String
  bytes       Int
  createdAt   DateTime  @default(now())
}

model Asset {
  id                 String        @id @default(cuid())
  workspaceId        String
  workspace          Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  jobId              String
  job                GenerationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  kind               AssetKind
  storageKey         String
  contentType        String
  bytes              Int
  sourceUrl          String
  aiGenerated        Boolean       @default(true) // AI 생성물 표시 의무 대응용 기록
  createdAt          DateTime      @default(now())
  approval           Approval      @default(PENDING)
  // 버전 기록: 문구를 얹은 새 버전은 원본을 parentAssetId로 가리킨다.
  parentAssetId      String?
  version            Int           @default(1)
  overlayText        String?
  virtualPersonLabel Boolean       @default(false) // '가상인물' 표시를 넣었는지

  @@unique([jobId, sourceUrl])
}

model WebhookDelivery {
  webhookId  String   @id
  requestId  String
  receivedAt DateTime @default(now())
}

// 사무실 임무. 사장(한결)에게 한 줄로 준 일 하나.
model Mission {
  id          String         @id @default(cuid())
  workspaceId String
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdById String
  prompt      String
  title       String
  status      String         @default("working") // working | done | stopped | error
  stage       String         @default("plan")
  state       Json           @default("{}")
  seq         Int            @default(0)
  busyUntil   DateTime       @default(now())
  createdAt   DateTime       @default(now())
  endedAt     DateTime?
  events      MissionEvent[]

  @@index([workspaceId, createdAt])
}

// 임무 중 실제로 일어난 일의 기록. 사무실 화면과 다시보기는 이 기록만 재생한다.
model MissionEvent {
  id        String   @id @default(cuid())
  missionId String
  mission   Mission  @relation(fields: [missionId], references: [id], onDelete: Cascade)
  seq       Int
  at        DateTime @default(now())
  ev        Json

  @@unique([missionId, seq])
}

// 모의매매 계좌. 실제 돈과 주문은 없다. 워크스페이스마다 하나.
model PaperAccount {
  workspaceId    String    @id
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  startEquity    Float     @default(10000) // USDC
  balance        Float     @default(10000) // 실현 손익과 수수료를 반영한 잔고
  riskPct        Float     @default(0.5) // 1회 위험, 잔고 대비 %
  dailyStopPct   Float     @default(1.5) // 하루(UTC) 실현 손실이 이만큼이면 새 진입 금지
  maxLeverage    Float     @default(1) // 포지션 금액 / 잔고 상한
  updatedAt      DateTime  @updatedAt
}

// 모의 거래 하나(진입부터 청산까지).
model PaperTrade {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  missionId   String?
  coin        String
  side        String // long | short
  qty         Float
  entry       Float
  stop        Float
  target      Float
  strategy    String
  interval    String
  openedAt    DateTime  @default(now())
  closeBy     DateTime // 보유 기간 상한
  checkedTo   DateTime  @default(now()) // 이 시각까지의 1분봉으로 손절·목표를 확인함
  status      String    @default("open") // open | closed
  exit        Float?
  exitReason  String? // stop | target | time | manual
  closedAt    DateTime?
  fees        Float     @default(0)
  pnl         Float? // 수수료 뺀 실현 손익(USDC)

  @@index([workspaceId, status])
}
