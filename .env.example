# 데이터베이스와 큐
DATABASE_URL="postgresql://ilson:ilson@localhost:5432/ilson"
REDIS_URL="redis://localhost:6379"
# inline: 큐 없이 요청 안에서 바로 처리(개발과 테스트용). bullmq: Redis 작업 큐 사용.
QUEUE_MODE="inline"

# Higgsfield (서버 전용. 브라우저 코드에 절대 넣지 않는다)
HF_API_BASE="https://api.higgsfield.ai"
HF_API_KEY_ID=""
HF_API_KEY_SECRET=""
# 콘솔 Settings에서 처음 열람할 때 생성되는 whsec_ 값. 열람 전에는 웹훅이 서명 없이 온다.
HF_WEBHOOK_SECRET=""
# 공개 HTTPS 주소. 비워 두면 웹훅 없이 조회(폴링)만 쓴다.
APP_PUBLIC_URL=""

# 원화 환산. 실제 환율이 아니라 운영자가 정하는 값이다. 아래 숫자는 예시.
USD_KRW_RATE="1400"

# 저장소: local 또는 s3
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./.storage"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# 글쓰기 LLM (서버 전용). OpenAI 호환 chat/completions 형식이면 된다. 기본값은 DeepSeek.
LLM_API_BASE="https://api.deepseek.com"
LLM_API_KEY=""
# 2026-11-10 GET /models로 확인한 이름: deepseek-flash, deepseek-v4-pro
LLM_MODEL="deepseek-flash"
